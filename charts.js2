/**
 * Pure Canvas Chart Renderer
 * Completely offline, zero dependencies (No Chart.js or D3 required).
 * Renders:
 * 1. Real-time Adaptive Sensor Fusion weight stream
 * 2. TensorRT Optimization comparison chart
 * 3. Trajectory Drift (EVO ATE/RPE) benchmark chart
 */

class OfflineCharts {
  constructor(degradationEngine) {
    this.degradation = degradationEngine;
    
    this.fusionCanvas = document.getElementById('fusionChart');
    if (this.fusionCanvas) {
      this.fusionCtx = this.fusionCanvas.getContext('2d');
      this.initFusionChart();
    }
  }
  
  initFusionChart() {
    const render = () => {
      const canvas = this.fusionCanvas;
      if (!canvas) return;
      
      const ctx = this.fusionCtx;
      const w = canvas.width = canvas.clientWidth || 600;
      const h = canvas.height = canvas.clientHeight || 200;
      
      ctx.clearRect(0, 0, w, h);
      
      // Grid lines
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
      ctx.lineWidth = 1;
      for (let y = 20; y < h - 20; y += 35) {
        ctx.beginPath();
        ctx.moveTo(40, y);
        ctx.lineTo(w - 20, y);
        ctx.stroke();
      }
      
      // Y-axis labels
      ctx.fillStyle = '#64748b';
      ctx.font = '10px monospace';
      ctx.fillText('100%', 10, 25);
      ctx.fillText('50%', 15, h / 2);
      ctx.fillText('0%', 20, h - 22);
      
      const history = this.degradation.history;
      if (history.length < 2) {
        requestAnimationFrame(render);
        return;
      }
      
      const stepX = (w - 70) / (this.degradation.maxHistory - 1);
      
      // Draw LiDAR Weight Line (Green)
      ctx.strokeStyle = '#00ff88';
      ctx.lineWidth = 2;
      ctx.beginPath();
      history.forEach((pt, i) => {
        const x = 50 + i * stepX;
        const y = h - 25 - (pt.lidar / 100) * (h - 50);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();
      
      // Draw VIO Weight Line (Cyan)
      ctx.strokeStyle = '#00f0ff';
      ctx.lineWidth = 2;
      ctx.beginPath();
      history.forEach((pt, i) => {
        const x = 50 + i * stepX;
        const y = h - 25 - (pt.vio / 100) * (h - 50);
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.stroke();
      
      // Legend
      ctx.fillStyle = '#00f0ff';
      ctx.fillRect(w - 180, 15, 8, 8);
      ctx.fillStyle = '#f0f4fc';
      ctx.fillText('VIO Weight', w - 165, 23);
      
      ctx.fillStyle = '#00ff88';
      ctx.fillRect(w - 95, 15, 8, 8);
      ctx.fillStyle = '#f0f4fc';
      ctx.fillText('LiDAR Weight', w - 80, 23);
      
      requestAnimationFrame(render);
    };
    
    render();
  }
}

window.OfflineCharts = OfflineCharts;
